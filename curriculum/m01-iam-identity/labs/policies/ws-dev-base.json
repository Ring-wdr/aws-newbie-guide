{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReceiptsReadWrite",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::todayorder-receipts/*"
    },
    {
      "Sid": "OrdersTable",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:Query", "dynamodb:PutItem", "dynamodb:DeleteTable"],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/todayorder-orders"
    },
    {
      "Sid": "LookAround",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    }
  ]
}
