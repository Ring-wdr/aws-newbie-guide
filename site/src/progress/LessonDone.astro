---
// 추적되는 레슨 페이지 끝의 "이 레슨 완료" 표시. 모듈 진행 추적과 같은 저장값("progress:mNN"의 lesson:<파일>)을 쓴다.
// 원고에는 표시가 없고 MarkdownContent.astro가 붙인다(모듈 README에 진행 추적 표시 줄이 있는 모듈의 레슨만).
import LessonDoneBox from './LessonDone.jsx';

interface Props {
  module: { code: string; key: string; href: string };
  item: { id: string; label: string };
}
const { module: m, item } = Astro.props;
---

<LessonDoneBox client:visible storeKey={m.key} itemId={item.id} label={item.label} moduleCode={m.code} moduleHref={m.href} />

<style is:global>
  .ld {
    margin: 2rem 0 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    overflow-wrap: anywhere;
  }
  .ld :is(p) { margin: 0; }
  .ld-check { display: inline-flex; gap: 0.5rem; align-items: center; cursor: pointer; font-weight: 700; }
  .ld-check input { width: 1.15rem; height: 1.15rem; accent-color: var(--sl-color-accent); margin: 0; }
  .ld[data-done='true'] .ld-state { color: var(--guide-ok); }
  .ld-note { color: var(--guide-muted); font-size: 0.8125rem; flex: 1 1 16rem; }
  .ld :is(input, a):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
</style>
