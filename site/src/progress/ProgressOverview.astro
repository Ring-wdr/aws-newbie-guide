---
// 홈의 전체 진행 요약(모듈별 완료 수). 원고에는 표시가 없고 MarkdownContent.astro가 홈의 첫 H2 앞에 놓는다.
// 목록은 진행 추적 표시 줄이 있는 모듈(catalog.mjs), 완료 수는 브라우저 localStorage의 "progress:mNN"에서 읽는다.
import { progressCatalog } from './catalog.mjs';
import Overview from './Overview.jsx';

const modules = progressCatalog().map((m) => ({ code: m.code, title: m.title, href: m.href, key: m.key, ids: m.items.map((it) => it.id) }));
---

{
  modules.length > 0 && (
    <div class="po-wrap">
      <Overview client:visible modules={modules} />
      <div class="po-storage" data-guide-storage></div>
    </div>
  )
}

<style is:global>
  .po-wrap {
    margin: 1rem 0 1.5rem;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .po :is(p, ol, h2) { margin: 0; }
  .po > * + * { margin-top: 0.6rem; }
  .po h2 { font-size: 1.15rem; border: 0; padding: 0; }
  .po-note { color: var(--guide-muted); font-size: 0.8125rem; }
  .po-list { list-style: none; padding: 0 !important; display: grid; gap: 0; }
  .po-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name count' 'bar bar';
    gap: 0.1rem 0.75rem;
    align-items: baseline;
    margin: 0 !important;
    padding: 0.4rem 0;
    border-top: 1px solid var(--guide-border);
  }
  @media (min-width: 72rem) {
    .po-list { grid-template-columns: 1fr 1fr; column-gap: 1.5rem; }
  }
  .po-name { grid-area: name; }
  .po-count { grid-area: count; white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--guide-muted); font-size: 0.875rem; }
  .po-list li[data-state='done'] .po-count { color: var(--guide-ok); font-weight: 700; }
  .po-bar { grid-area: bar; display: block; width: 100%; height: 0.55rem; accent-color: var(--sl-color-accent); }
  .po a:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .po-storage { margin-top: 0.75rem; }
  .po-storage button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.85rem;
    min-height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--guide-border);
    background: var(--guide-surface-2);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .po-storage button:hover { border-color: var(--sl-color-accent); }
</style>
