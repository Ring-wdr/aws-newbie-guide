---
// M08 레슨 2 — Route 53 라우팅 정책별 "어느 레코드가 답하나"(설명용 모형).
// 레코드와 규칙은 빌드 때 원고(02-routing-policies-and-health-checks.md)의 워크시트 표·정답·정책 표에서 읽는다(facts.mjs). 읽지 못하면 빌드가 실패한다.
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT } from '../../../lib/repo.mjs';
import { readRoutingFacts, LESSON } from './facts.mjs';
import Routing from './Routing.jsx';

const facts = readRoutingFacts(fs.readFileSync(path.join(REPO_ROOT, LESSON), 'utf8'));
---

<Routing client:visible facts={facts} />

<style is:global>
  .rr {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .rr :is(p, ul, ol, fieldset, details, table) { margin: 0; }
  .rr > * + * { margin-top: 0.85rem; }
  .rr-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .rr-head h4 { margin: 0; font-size: 1.05rem; }
  .rr-model {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--guide-y-fg);
    background: var(--guide-y-bg);
  }
  .rr-intro, .rr-hint, .rr small { color: var(--guide-muted); }
  .rr small { font-size: 0.8125rem; line-height: 1.5; }
  .rr fieldset { border: 0; padding: 0; min-width: 0; }
  .rr legend { font-weight: 700; padding: 0; margin-bottom: 0.3rem; }
  .rr-row { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; align-items: center; }
  .rr-hint { margin-top: 0.35rem !important; font-size: 0.8125rem; }
  .rr button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.8rem;
    min-height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--guide-border);
    background: var(--guide-surface-2);
    color: var(--sl-color-text);
    cursor: pointer;
    text-align: left;
  }
  .rr button code { background: none; padding: 0; font-size: 0.875rem; }
  .rr button:hover { border-color: var(--sl-color-accent); }
  .rr button[aria-pressed='true'] { border-color: var(--sl-color-accent); box-shadow: inset 0 0 0 1px var(--sl-color-accent); font-weight: 700; }
  .rr button[aria-pressed='true']::before { content: '✓ '; }
  .rr :is(button, input, summary, .rr-table-scroll):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .rr-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.85rem 1.25rem; }
  .rr-radios label { display: flex; gap: 0.4rem; align-items: baseline; margin-bottom: 0.2rem; }
  .rr-inline { display: block; }
  .rr-check { display: inline-flex; gap: 0.4rem; align-items: center; }
  .rr input[type='number'] {
    font: inherit;
    width: 5.5rem;
    padding: 0.25rem 0.4rem;
    border: 1px solid var(--guide-border);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  .rr input:disabled { opacity: 0.55; }
  .rr-result {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--guide-border);
    border-radius: var(--guide-radius);
    background: var(--sl-color-bg);
  }
  .rr-tag { font-weight: 700; }
  .rr-result[data-kind='answer'] .rr-tag, .rr-result[data-kind='weighted'] .rr-tag { color: var(--guide-ok); }
  .rr-result[data-kind='nodata'] .rr-tag, .rr-result[data-kind='none'] .rr-tag { color: var(--guide-bad); }
  .rr-steps, .rr-dist { margin-top: 0.4rem !important; padding-left: 1.2rem; font-size: 0.875rem; }
  .rr-dist { list-style: none; padding-left: 0 !important; }
  .rr-dist li { margin: 0 0 0.3rem !important; }
  .rr-pbar { display: block; height: 0.6rem; margin-top: 0.15rem; border: 1px solid var(--guide-border); border-radius: 0.2rem; background: var(--guide-surface-2); }
  .rr-pbar > span { display: block; height: 100%; background: repeating-linear-gradient(135deg, var(--sl-color-accent) 0 3px, transparent 3px 6px); }
  .rr-recs { list-style: none; padding: 0 !important; display: grid; gap: 0.5rem; }
  .rr-rec {
    margin: 0 !important;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--guide-border);
    border-radius: var(--guide-radius);
    background: var(--sl-color-bg);
  }
  /* 답한 레코드: 굵은 실선 테두리(색 + 모양), 제외된 레코드: 점선 테두리, 지운 레코드: 흐리게 + "—" 글자 */
  .rr-rec[data-mark='✓'] { border: 2px solid var(--guide-ok); }
  .rr-rec[data-mark='✕'] { border: 2px dashed var(--guide-bad); }
  .rr-rec[data-mark='—'] .rr-rec-head { text-decoration: line-through; color: var(--guide-muted); }
  .rr-rec > * + * { margin-top: 0.3rem !important; }
  .rr-status { font-size: 0.875rem; font-weight: 700; }
  .rr-rec[data-mark='✓'] .rr-status { color: var(--guide-ok); }
  .rr-rec[data-mark='✕'] .rr-status { color: var(--guide-bad); }
  .rr-val { font-family: var(--sl-font-mono, monospace); font-size: 0.875rem; }
  .rr details > summary { cursor: pointer; font-weight: 700; width: fit-content; }
  .rr-table-scroll { overflow-x: auto; margin-top: 0.5rem; }
  .rr-table { width: 100%; min-width: 34rem; border-collapse: collapse; font-size: 0.8125rem; display: table; overflow-wrap: normal; word-break: keep-all; }
  .rr-table :is(th, td) { border: 1px solid var(--guide-border); padding: 0.3rem 0.45rem; text-align: left; vertical-align: top; }
  .rr-assume ul { margin-top: 0.4rem !important; padding-left: 1.2rem; }
  @media (prefers-reduced-motion: reduce) {
    .rr * { transition: none !important; animation: none !important; }
  }
</style>
