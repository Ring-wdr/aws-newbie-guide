---
// M00 레슨 4 — CLI 요청 한 번의 여정과 종료 코드(설명용 모형).
// 단계·종료 코드·오류 코드는 빌드 때 원고(04-first-request-anatomy.md, 03-environment-setup.md)에서 읽는다(facts.mjs). 읽지 못하면 빌드가 실패한다.
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT } from '../../../lib/repo.mjs';
import { readRequestFacts, LESSON, SETUP } from './facts.mjs';
import Journey from './Journey.jsx';

const read = (rel: string) => fs.readFileSync(path.join(REPO_ROOT, rel), 'utf8');
const facts = readRequestFacts(read(LESSON), read(SETUP));
---

<Journey client:visible facts={facts} />

<style is:global>
  .rj {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .rj :is(p, ul, ol, fieldset, details, table) { margin: 0; }
  .rj > * + * { margin-top: 0.85rem; }
  .rj-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .rj-head h4 { margin: 0; font-size: 1.05rem; }
  .rj-model {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--guide-y-fg);
    background: var(--guide-y-bg);
  }
  .rj-intro, .rj small { color: var(--guide-muted); }
  .rj small { display: block; font-size: 0.8125rem; line-height: 1.5; }
  .rj fieldset { border: 0; padding: 0; min-width: 0; }
  .rj legend { font-weight: 700; padding: 0; margin-bottom: 0.3rem; }
  .rj :is(input, summary):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .rj-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 0.85rem 1.25rem; }
  .rj-field { display: flex; flex-direction: column; gap: 0.2rem; }
  .rj-field label { display: flex; gap: 0.4rem; align-items: baseline; }
  .rj-result {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--guide-border);
    border-radius: var(--guide-radius);
    background: var(--sl-color-bg);
  }
  .rj-result > p + p { margin-top: 0.4rem; }
  .rj-tag { font-weight: 700; }
  .rj-result[data-exit='0'] .rj-tag { color: var(--guide-ok); }
  .rj-result:not([data-exit='0']) .rj-tag { color: var(--guide-bad); }
  .rj-note { font-size: 0.875rem; color: var(--guide-muted); }
  .rj-stages { list-style: none; padding: 0 !important; display: flex; flex-direction: column; gap: 0.35rem; }
  .rj-stage {
    margin: 0 !important;
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.4rem 0.6rem;
    border: 2px solid var(--guide-border);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
  }
  .rj-n {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    border: 1.5px solid currentColor;
    border-radius: 999px;
  }
  .rj-body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .rj-name { font-weight: 700; }
  .rj-state { font-size: 0.8125rem; white-space: nowrap; }
  .rj-desc { font-size: 0.8125rem; color: var(--guide-muted); }
  .rj-stage[data-state='ok'] .rj-state { color: var(--guide-ok); }
  .rj-stage[data-state='fail'] { border-color: var(--guide-bad); border-width: 3px; }
  .rj-stage[data-state='fail'] .rj-state { color: var(--guide-bad); }
  .rj-stage[data-state='skip'] { border-style: dashed; }
  .rj-stage[data-state='skip'] :is(.rj-name, .rj-state) { color: var(--guide-muted); }
  .rj details > summary { cursor: pointer; font-weight: 700; width: fit-content; }
  .rj-table-scroll { overflow-x: auto; margin-top: 0.5rem; }
  .rj-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; display: table; }
  .rj-table :is(th, td) { border: 1px solid var(--guide-border); padding: 0.3rem 0.45rem; text-align: left; vertical-align: top; }
  .rj-table :is(th, td):first-child { white-space: nowrap; }
  .rj-table tr[aria-current='true'] { background: var(--sl-color-accent-low); font-weight: 700; }
  .rj-assume ul { margin-top: 0.4rem !important; padding-left: 1.2rem; }
  @media (prefers-reduced-motion: reduce) {
    .rj * { transition: none !important; animation: none !important; }
  }
</style>
