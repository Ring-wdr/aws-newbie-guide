---
// M06 레슨 2 — SQS 가시성 타임아웃 타임라인(설명용 모형).
// 수치는 빌드 때 원고(curriculum/m06-integration-messaging/02-sqs.md)에서 읽는다(facts.mjs). 읽지 못하면 빌드가 실패한다.
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT } from '../../../lib/repo.mjs';
import { readVisibilityFacts, LESSON } from './facts.mjs';
import Timeline from './Timeline.jsx';

const facts = readVisibilityFacts(fs.readFileSync(path.join(REPO_ROOT, LESSON), 'utf8'));
---

<Timeline client:visible facts={facts} />

<style is:global>
  .vt {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .vt :is(p, ul, fieldset, figure, details, table) { margin: 0; }
  .vt > * + * { margin-top: 0.85rem; }
  .vt-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .vt-head h4 { margin: 0; font-size: 1.05rem; }
  .vt-model {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--guide-y-fg);
    background: var(--guide-y-bg);
  }
  .vt-intro, .vt-hint, .vt small { color: var(--guide-muted); }
  .vt small { display: block; font-size: 0.8125rem; line-height: 1.5; }
  .vt fieldset { border: 0; padding: 0; min-width: 0; }
  .vt legend { font-weight: 700; padding: 0; margin-bottom: 0.3rem; }
  .vt-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .vt-hint { margin-top: 0.35rem !important; font-size: 0.8125rem; }
  .vt button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.8rem;
    min-height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--guide-border);
    background: var(--guide-surface-2);
    color: var(--sl-color-text);
    cursor: pointer;
    text-align: left;
  }
  .vt button:hover:not(:disabled) { border-color: var(--sl-color-accent); }
  .vt button:disabled { opacity: 0.55; cursor: not-allowed; }
  .vt button[aria-pressed='true'] { border-color: var(--sl-color-accent); box-shadow: inset 0 0 0 1px var(--sl-color-accent); font-weight: 700; }
  .vt button[aria-pressed='true']::before { content: '✓ '; }
  .vt :is(button, input):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .vt-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.85rem 1.25rem; }
  .vt-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .vt-field > span, .vt-sub > span { font-weight: 700; }
  .vt input[type='number'] {
    font: inherit;
    width: 100%;
    max-width: 12rem;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--guide-border);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  .vt input[type='number']:disabled { opacity: 0.55; }
  .vt-radios label, .vt-check { display: flex; gap: 0.4rem; align-items: baseline; }
  .vt-sub { display: flex; flex-direction: column; gap: 0.25rem; margin-top: 0.3rem; }
  .vt-result {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--guide-border);
    border-radius: var(--guide-radius);
    background: var(--sl-color-bg);
  }
  .vt-tag { font-weight: 700; }
  .vt-result[data-result='deleted'] .vt-tag { color: var(--guide-ok); }
  .vt-result[data-result='dlq'] .vt-tag, .vt-result[data-result='looping'] .vt-tag { color: var(--guide-bad); }
  .vt-now { margin-top: 0.4rem !important; }
  .vt-chart { padding: 0.5rem 0; }
  .vt-legend { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; font-size: 0.8125rem; color: var(--guide-muted); }
  .vt-legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .vt-sw { display: inline-block; width: 1.6rem; height: 0.8rem; border-radius: 0.2rem; }
  .vt-lanes { list-style: none; padding: 0 !important; margin: 0.5rem 0 0 !important; }
  .vt-lane { margin: 0 0 0.45rem !important; padding: 0 !important; }
  .vt-lane-label { display: block; font-size: 0.8125rem; line-height: 1.4; }
  .vt-status[data-status='delete'] { color: var(--guide-ok); font-weight: 700; }
  .vt-status[data-status='fail'] { color: var(--guide-bad); font-weight: 700; }
  .vt-track {
    position: relative;
    display: block;
    height: 1.4rem;
    margin-top: 0.15rem;
    border-radius: 0.25rem;
    background: var(--guide-surface-2);
  }
  .vt-seg { position: absolute; top: 0; bottom: 0; min-width: 2px; }
  /* 안 보임 구간: 테두리 상자(색 + 모양). 처리 구간: 빗금 막대(색 + 무늬) */
  .vt-seg-hidden, .vt-sw-hidden {
    border: 2px solid var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    border-radius: 0.25rem;
  }
  .vt-seg-work { top: 0.4rem; bottom: 0.4rem; }
  .vt-seg-work, .vt-sw-work {
    background: repeating-linear-gradient(135deg, var(--sl-color-text) 0 3px, transparent 3px 6px);
    border: 1px solid var(--sl-color-text);
  }
  .vt-now-line { position: absolute; top: -0.2rem; bottom: -0.2rem; width: 0; border-left: 2px dashed var(--guide-bad); }
  .vt-axis { display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--guide-muted); }
  .vt details > summary { cursor: pointer; font-weight: 700; width: fit-content; }
  .vt-table-scroll { overflow-x: auto; margin-top: 0.5rem; }
  .vt-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; display: table; }
  .vt-table :is(th, td) { border: 1px solid var(--guide-border); padding: 0.3rem 0.45rem; text-align: left; vertical-align: top; }
  .vt-table :is(td, th):is(:first-child, :nth-child(2)) { white-space: nowrap; }
  .vt-table tr[aria-current='step'] { background: var(--sl-color-accent-low); font-weight: 700; }
  .vt-table tr.vt-future { color: var(--guide-muted); }
  .vt-assume ul { margin-top: 0.4rem !important; padding-left: 1.2rem; }
  @media (prefers-reduced-motion: reduce) {
    .vt * { transition: none !important; animation: none !important; }
  }
</style>
