---
// M06 진행 추적(레슨·실습·퀴즈 완료 표시와 진행률). 저장은 브라우저 localStorage에만(storage.ts).
// 항목은 빌드 때 원고에서 읽는다: 모듈 README의 "## 레슨"·"## 실습" 표와 quiz.md 링크, 퀴즈 문항 수는 quiz.md.
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT, routeForRepoPath, fileViewRoute } from '../../../lib/repo.mjs';
import { readModuleItems, countQuizQuestions } from './progress.mjs';
import Tracker from './Tracker.jsx';

const MODULE_DIR = 'curriculum/m06-integration-messaging';
const read = (rel: string) => fs.readFileSync(path.join(REPO_ROOT, rel), 'utf8');
const items = readModuleItems(read(`${MODULE_DIR}/README.md`), MODULE_DIR).map((it) => ({
  ...it,
  href: it.file.endsWith('.md') ? routeForRepoPath(it.file) : fileViewRoute(it.file),
}));
const quizRoute = routeForRepoPath(`${MODULE_DIR}/quiz.md`);
const quizTotal = countQuizQuestions(read(`${MODULE_DIR}/quiz.md`));
---

<div class="pt-wrap">
  <Tracker client:visible items={items} quizRoute={quizRoute} quizTotal={quizTotal} moduleTitle="M06" />
  {/* 진행 상태 백업(JSON 내보내기/가져오기)은 공용 storage.ts가 이 자리에 붙인다. 완료 표시도 함께 담긴다. */}
  <div class="pt-storage" data-guide-storage></div>
</div>

<style is:global>
  .pt-wrap {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .pt :is(p, ul, fieldset, h3) { margin: 0; }
  .pt > * + * { margin-top: 0.75rem; }
  .pt h3 { font-size: 1.1rem; }
  .pt-summary { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; align-items: baseline; }
  .pt-kinds { color: var(--guide-muted); font-size: 0.875rem; }
  .pt-bar {
    display: block;
    width: 100%;
    height: 0.9rem;
    accent-color: var(--sl-color-accent);
  }
  .pt-note { color: var(--guide-muted); font-size: 0.8125rem; }
  .pt-group { border: 0; padding: 0; min-width: 0; }
  .pt-group legend { font-weight: 700; padding: 0; }
  .pt-count { font-weight: 400; color: var(--guide-muted); font-size: 0.875rem; }
  .pt-group ul { list-style: none; padding: 0 !important; margin: 0.3rem 0 0 !important; }
  .pt-group li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.15rem 0.5rem;
    align-items: start;
    margin: 0 !important;
    padding: 0.35rem 0;
    border-top: 1px solid var(--guide-border);
  }
  .pt-group li input { margin-top: 0.35rem; width: 1.1rem; height: 1.1rem; accent-color: var(--sl-color-accent); }
  .pt-group li label { cursor: pointer; line-height: 1.5; }
  .pt-mark { display: inline-block; width: 1.2em; font-weight: 700; color: var(--guide-muted); }
  .pt-group li[data-done='true'] .pt-mark { color: var(--guide-ok); }
  .pt-state { color: var(--guide-ok); font-weight: 700; }
  .pt-open { white-space: nowrap; font-size: 0.875rem; padding-top: 0.1rem; }
  .pt-quiz-record { grid-column: 2 / -1; color: var(--guide-muted); font-size: 0.8125rem; }
  .pt :is(input, a, button):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .pt-reset,
  .pt-storage button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.85rem;
    min-height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--guide-border);
    background: var(--guide-surface-2);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .pt-storage button:hover,
  .pt-reset:hover:not(:disabled) { border-color: var(--sl-color-accent); }
  .pt-reset:disabled { opacity: 0.55; cursor: not-allowed; }
  .pt-storage { margin-top: 0.75rem; }
</style>
