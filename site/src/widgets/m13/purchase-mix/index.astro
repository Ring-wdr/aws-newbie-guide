---
// M13 레슨 2 — 사용 패턴에 따라 구매 옵션 섞기(설명용 모형).
// 숫자는 빌드 때 원고(curriculum/m13-cost-optimization/02-compute-cost.md 워크시트 2)에서 읽는다(facts.mjs).
// 읽지 못하거나 모형이 모범 답안의 월 비용을 다시 내지 못하면 빌드가 실패한다.
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT } from '../../../lib/repo.mjs';
import { readMixFacts, LESSON } from './facts.mjs';
import Mix from './Mix.jsx';

const facts = readMixFacts(fs.readFileSync(path.join(REPO_ROOT, LESSON), 'utf8'));
---

<Mix client:visible facts={facts} />

<style is:global>
  .pmx {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .pmx :is(p, ul, fieldset, figure, details, table) { margin: 0; }
  .pmx > * + * { margin-top: 0.85rem; }
  .pmx-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .pmx-head h4 { margin: 0; font-size: 1.05rem; }
  .pmx-model {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--guide-y-fg);
    background: var(--guide-y-bg);
  }
  .pmx-intro, .pmx-hint, .pmx small, .pmx-legend { color: var(--guide-muted); }
  .pmx small { display: block; font-size: 0.8125rem; line-height: 1.5; }
  .pmx-hint, .pmx-legend { font-size: 0.8125rem; }
  .pmx-presets .pmx-hint { margin-top: 0.35rem; }
  .pmx fieldset { border: 0; padding: 0; min-width: 0; }
  .pmx legend { font-weight: 700; padding: 0; margin-bottom: 0.3rem; }
  .pmx-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .pmx button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.8rem;
    min-height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--guide-border);
    background: var(--guide-surface-2);
    color: var(--sl-color-text);
    cursor: pointer;
    text-align: left;
  }
  .pmx button:hover { border-color: var(--sl-color-accent); }
  .pmx button[aria-pressed='true'] { border-color: var(--sl-color-accent); box-shadow: inset 0 0 0 1px var(--sl-color-accent); font-weight: 700; }
  .pmx button[aria-pressed='true']::before { content: '✓ '; }
  .pmx :is(button, input, summary):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .pmx-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 0.85rem 1.25rem; }
  .pmx-field { display: flex; flex-direction: column; gap: 0.25rem; min-width: 0; }
  .pmx-field > span { font-weight: 700; }
  .pmx input[type='range'] { width: 100%; max-width: 22rem; accent-color: var(--sl-color-accent); }
  .pmx-radios label { display: flex; gap: 0.4rem; align-items: baseline; }
  .pmx-check { margin-top: 0.3rem; }
  .pmx-result {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--guide-border);
    border-radius: var(--guide-radius);
    background: var(--sl-color-bg);
  }
  .pmx-result > * + * { margin-top: 0.4rem !important; }
  .pmx-total { font-size: 1.05rem; }
  .pmx-warn { color: var(--guide-r-fg); background: var(--guide-r-bg); border: 1px dashed var(--guide-r-bd); border-radius: 0.3rem; padding: 0.2rem 0.45rem; font-size: 0.875rem; }
  .pmx-fig figcaption { font-weight: 700; font-size: 0.875rem; margin-bottom: 0.35rem; }
  .pmx-stack { display: flex; height: 1.6rem; border: 1px solid var(--guide-border); border-radius: 0.3rem; overflow: hidden; background: var(--guide-surface-2); }
  .pmx-seg { display: block; height: 100%; }
  .pmx-parts { list-style: none; padding: 0 !important; margin-top: 0.4rem !important; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; font-size: 0.8125rem; }
  .pmx-parts li { margin: 0 !important; display: inline-flex; align-items: center; gap: 0.35rem; }
  .pmx-sw { display: inline-block; width: 1.4rem; height: 0.8rem; border-radius: 0.15rem; border: 1px solid var(--sl-color-text); }
  /* 색과 무늬를 함께: 쓴 약정 = 채움, 쓰지 않은 약정 = 빗금(빨강), 온디맨드 = 점, 스팟 = 가로줄 */
  .pmx-sp-used { background: var(--sl-color-accent); }
  .pmx-sp-waste { background: repeating-linear-gradient(135deg, var(--guide-bad) 0 3px, transparent 3px 7px); }
  .pmx-od { background: radial-gradient(var(--sl-color-text) 1.2px, transparent 1.6px) 0 0 / 6px 6px, var(--guide-surface-2); }
  .pmx-spot { background: repeating-linear-gradient(0deg, var(--guide-ok) 0 2px, transparent 2px 5px); }
  .pmx-batch-od { background: radial-gradient(var(--guide-muted) 1.2px, transparent 1.6px) 0 0 / 4px 4px, var(--guide-surface); }
  .pmx-seg + .pmx-seg { border-left: 2px solid var(--sl-color-bg); }
  .pmx-bars { display: grid; grid-template-columns: repeat(13, minmax(0, 1fr)); gap: 3px; height: 8rem; align-items: end; }
  .pmx-bar { position: relative; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 1.2rem; }
  .pmx-bar-fill { display: block; background: var(--sl-color-accent-low); border: 1px solid var(--sl-color-accent); border-radius: 0.15rem 0.15rem 0 0; }
  .pmx-cur .pmx-bar-fill { background: var(--sl-color-accent); border-width: 2px; border-color: var(--sl-color-text); }
  .pmx-bar-k { position: absolute; bottom: 0; left: 0; right: 0; text-align: center; font-size: 0.75rem; }
  .pmx-best .pmx-bar-k::before { content: '★'; }
  .pmx-cur .pmx-bar-k { font-weight: 700; text-decoration: underline; }
  .pmx details > summary { cursor: pointer; font-weight: 700; width: fit-content; }
  .pmx-table-scroll { overflow-x: auto; margin-top: 0.5rem; }
  .pmx-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; display: table; }
  .pmx-table caption { text-align: left; font-size: 0.8125rem; color: var(--guide-muted); }
  .pmx-table :is(th, td) { border: 1px solid var(--guide-border); padding: 0.3rem 0.45rem; text-align: left; vertical-align: top; }
  .pmx-table tr[aria-current] { background: var(--sl-color-accent-low); font-weight: 700; }
  .pmx-assume ul { margin-top: 0.4rem !important; padding-left: 1.2rem; }
  @media (prefers-reduced-motion: reduce) {
    .pmx * { transition: none !important; animation: none !important; }
  }
</style>
