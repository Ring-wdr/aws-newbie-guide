---
// M03 레슨 6 — Auto Scaling 조정 정책 계산기(설명용 모형).
// 수치는 빌드 때 원고(06-auto-scaling.md)와 lab 정책 파일(labs/policies/*.json)에서 읽는다(facts.mjs). 읽지 못하면 빌드가 실패한다.
import fs from 'node:fs';
import path from 'node:path';
import { REPO_ROOT } from '../../../lib/repo.mjs';
import { readScalingFacts, LESSON, POLICY_DIR, POLICY_FILES } from './facts.mjs';
import Calculator from './Calculator.jsx';

const read = (rel: string) => fs.readFileSync(path.join(REPO_ROOT, rel), 'utf8');
const policies = Object.fromEntries(Object.entries(POLICY_FILES).map(([k, f]) => [k, read(`${POLICY_DIR}/${f}`)]));
const facts = readScalingFacts(read(LESSON), policies as any);
---

<Calculator client:visible facts={facts} />

<style is:global>
  .as {
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--guide-border);
    border-left: 4px solid var(--sl-color-accent);
    border-radius: var(--guide-radius);
    background: var(--guide-surface);
    font-size: 0.9375rem;
    overflow-wrap: anywhere;
  }
  .as :is(p, ul, ol, fieldset, figure, details, table) { margin: 0; }
  .as > * + * { margin-top: 0.85rem; }
  .as-head { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; }
  .as-head h4 { margin: 0; font-size: 1.05rem; }
  .as-model {
    display: inline-block;
    padding: 0 0.5rem;
    border: 1px dashed currentColor;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--guide-y-fg);
    background: var(--guide-y-bg);
  }
  .as-intro, .as-hint, .as small { color: var(--guide-muted); }
  .as small { display: block; font-size: 0.8125rem; line-height: 1.5; }
  .as fieldset { border: 0; padding: 0; min-width: 0; }
  .as legend { font-weight: 700; padding: 0; margin-bottom: 0.3rem; }
  .as-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .as-hint { margin-top: 0.35rem !important; font-size: 0.8125rem; }
  .as button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.3rem 0.8rem;
    min-height: 2.25rem;
    border-radius: 0.4rem;
    border: 1px solid var(--guide-border);
    background: var(--guide-surface-2);
    color: var(--sl-color-text);
    cursor: pointer;
  }
  .as button:hover { border-color: var(--sl-color-accent); }
  .as button[aria-pressed='true'] { border-color: var(--sl-color-accent); box-shadow: inset 0 0 0 1px var(--sl-color-accent); font-weight: 700; }
  .as button[aria-pressed='true']::before { content: '✓ '; }
  .as :is(button, input, summary):focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .as-controls { display: grid; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); gap: 0.85rem 1.25rem; }
  .as-field { display: flex; flex-direction: column; gap: 0.35rem; }
  .as-radios label, .as-check { display: flex; gap: 0.4rem; align-items: baseline; }
  .as-nums { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; }
  .as-nums label, .as-metric { display: flex; flex-direction: column; gap: 0.2rem; }
  .as-nums label > span, .as-metric > span { font-weight: 700; }
  .as input[type='number'] {
    font: inherit;
    width: 6.5rem;
    max-width: 100%;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--guide-border);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  .as-metric input[type='number'] { width: 10rem; }
  .as input[type='number']:disabled { opacity: 0.55; }
  .as-sub { display: flex; flex-direction: column; gap: 0.35rem; }
  .as-result {
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--guide-border);
    border-radius: var(--guide-radius);
    background: var(--sl-color-bg);
  }
  .as-result > * + * { margin-top: 0.4rem !important; }
  .as-tag { font-weight: 700; }
  .as-lines { padding-left: 1.3rem; font-size: 0.875rem; }
  .as-lines li { margin: 0.1rem 0 0 !important; }
  .as-note { font-size: 0.875rem; color: var(--guide-muted); }
  .as-chart { display: flex; flex-direction: column; gap: 0.5rem; }
  .as-slots-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.75rem; }
  .as-slots-label { min-width: 7.5rem; font-size: 0.875rem; font-weight: 700; }
  .as-slots { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .as-slot {
    display: inline-grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    font-size: 0.85rem;
    font-style: normal;
    line-height: 1;
    border: 1.5px dashed var(--guide-muted);
    border-radius: 0.2rem;
    color: var(--sl-color-text);
  }
  .as-slot[data-on='true'] { border-style: solid; border-color: var(--sl-color-text); background: var(--sl-color-accent-low); }
  .as-slot[data-min='true'] { box-shadow: inset 0 -3px 0 var(--sl-color-text); }
  .as-legend { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; font-size: 0.8125rem; color: var(--guide-muted); }
  .as-legend span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .as details > summary { cursor: pointer; font-weight: 700; width: fit-content; }
  .as-table-scroll { overflow-x: auto; margin-top: 0.5rem; }
  .as-table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; display: table; }
  .as-table :is(th, td) { border: 1px solid var(--guide-border); padding: 0.3rem 0.45rem; text-align: left; vertical-align: top; }
  .as-table th { white-space: nowrap; width: 1%; }
  .as-assume ul { margin-top: 0.4rem !important; padding-left: 1.2rem; }
  @media (prefers-reduced-motion: reduce) {
    .as * { transition: none !important; animation: none !important; }
  }
</style>
