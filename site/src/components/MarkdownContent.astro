---
// Starlight의 본문 상자를 대신한다. 본문 HTML 안의 자리 표시를 실제 컴포넌트로 바꾼다.
//   <div data-guide-widget="mNN/이름">  → src/widgets/mNN/이름/index.astro (디렉터리로 찾는다, 등록 파일 없음)
//   <div data-guide-widget="mNN/이름">  → 모듈 폴더에 없고 공용 위젯(src/lib/shared-widgets.mjs)이면 공용 구현에 모듈을 넘겨 그린다
//   <div data-guide-component="exam">   → 모의고사 시험 모드(ExamApp)
// 그 밖에 진행 추적이 붙이는 것(원고에는 표시가 없다): 홈의 "전체 진행" 요약(첫 H2 앞), 추적되는 레슨 페이지 끝의 "이 레슨 완료".
// 자리 표시가 없으면 Starlight가 넘겨 준 본문(slot)을 그대로 보인다.
import '@astrojs/starlight/style/markdown.css';
import ExamApp from './ExamApp.astro';
import ProgressTracker from '../progress/ProgressTracker.astro';
import ProgressOverview from '../progress/ProgressOverview.astro';
import LessonDone from '../progress/LessonDone.astro';
import { SHARED_WIDGETS } from '../lib/shared-widgets.mjs';
import { allContentFiles, idForRepoPath, moduleOf } from '../lib/repo.mjs';
import { lessonOf } from '../progress/catalog.mjs';

const route = Astro.locals.starlightRoute;
const entry = route?.entry as { id?: string; rendered?: { html?: string }; filePath?: string } | undefined;
let html = entry?.rendered?.html;
// 홈의 콘텐츠 id는 ""(Starlight가 index를 비운다), 나머지는 idForRepoPath와 같다.
const rel = entry?.id !== undefined ? allContentFiles().find((f) => idForRepoPath(f) === (entry.id || 'index')) : undefined;
const shared: Record<string, any> = { 'progress-tracker': ProgressTracker };
const lesson = rel ? lessonOf(rel) : null;
const OVERVIEW_MARK = '<div data-guide-component="progress-overview"></div>';
if (html && rel === 'README.md') {
  // 홈: 첫 H2 앞(없으면 맨 앞)에 전체 진행 요약을 둔다.
  const at = html.search(/<h2[\s>]/);
  html = at >= 0 ? html.slice(0, at) + OVERVIEW_MARK + html.slice(at) : OVERVIEW_MARK + html;
}
if (html && lesson) html += '<div data-guide-component="lesson-done"></div>';

// 위젯 모듈 목록(지연 로딩). 키에서 "mNN/이름"을 뽑는다.
const widgetModules = import.meta.glob('@guide-widgets/*/*/index.astro');
const widgets = new Map<string, () => Promise<any>>();
for (const [key, load] of Object.entries(widgetModules)) {
  const m = /\/(m\d\d)\/([a-z0-9-]+)\/index\.astro$/.exec(key);
  if (m) widgets.set(`${m[1]}/${m[2]}`, load);
}

type Part =
  | { kind: 'html'; html: string }
  | { kind: 'widget'; Comp: any; name: string; props: Record<string, unknown> }
  | { kind: 'exam' | 'progress-overview' | 'lesson-done' };
let parts: Part[] | null = null;
const MARK = /<div data-guide-(widget|component)="([^"]+)"><\/div>/g;
if (html && /data-guide-(widget|component)=/.test(html)) {
  parts = [];
  let last = 0;
  for (const m of html.matchAll(MARK)) {
    parts.push({ kind: 'html', html: html.slice(last, m.index) });
    if (m[1] === 'component' && (m[2] === 'exam' || m[2] === 'progress-overview' || m[2] === 'lesson-done')) parts.push({ kind: m[2] });
    else if (m[1] === 'widget') {
      const load = widgets.get(m[2]);
      const name = m[2].split('/')[1];
      if (load) {
        const mod = await load();
        parts.push({ kind: 'widget', Comp: mod.default, name: m[2], props: {} });
      } else if (SHARED_WIDGETS.includes(name) && shared[name] && rel && moduleOf(rel)) {
        parts.push({ kind: 'widget', Comp: shared[name], name: m[2], props: { modDir: moduleOf(rel) } });
      } else {
        // 변환기가 이미 디렉터리를 확인했으므로 여기서 없으면 빌드 설정(별칭) 문제다.
        throw new Error(`위젯 "${m[2]}"을 찾지 못했다(@guide-widgets/${m[2]}/index.astro)`);
      }
    } else throw new Error(`알 수 없는 컴포넌트 자리 표시: ${m[0]}`);
    last = m.index! + m[0].length;
  }
  parts.push({ kind: 'html', html: html.slice(last) });
}
---

<div class="sl-markdown-content">
  {
    parts
      ? parts.map((p) =>
          p.kind === 'html' ? (
            <Fragment set:html={p.html} />
          ) : p.kind === 'exam' ? (
            <ExamApp />
          ) : p.kind === 'progress-overview' ? (
            <div class="guide-widget not-content" data-widget="progress-overview">
              <ProgressOverview />
            </div>
          ) : p.kind === 'lesson-done' ? (
            <div class="guide-widget not-content" data-widget="lesson-done">
              <LessonDone module={lesson!.module} item={lesson!.item} />
            </div>
          ) : (
            <div class="guide-widget not-content" data-widget={p.name}>
              <p.Comp {...p.props} />
            </div>
          ),
        )
      : <slot />
  }
</div>

<script>
  import '../scripts/guide-client';
</script>
